# BFF / API Gateway — Endpoint del Backend for Frontend en AWS
VITE_BFF_URL=https://<api-gateway-id>.execute-api.<region>.amazonaws.com/api/v1

# Cognito Hosted UI — User Pool Residentes
VITE_COGNITO_DOMAIN=<prefix>-<account-id>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<cognito-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Nombre del Condominio para la UI
VITE_CONDOMINIO_NOMBRE="Torres del Parque"

# Entorno local (docker-compose.yml de la raíz del workspace)
# Copiar estas 3 líneas a .env.local y arrancar con `npm run dev:local`,
# que falla de inmediato si .env.local no existe (en vez de pegarle a AWS).
# `npm run dev` tambien las toma, pero sin esa verificación previa.
# .env.local no se versiona: .gitignore ignora `.env` y `*.local`.
# VITE_BFF_URL: BFF publicado en el host (puerto 3000 del compose).
# VITE_JWKS_MOCK_URL: ms-jwks-mock del compose, para el login demo local.
VITE_BFF_URL=http://localhost:3000/api/v1
VITE_JWKS_MOCK_URL=http://localhost:4000
VITE_CONDOMINIO_NOMBRE="Torres del Parque (Local)"
