# BFF / API Gateway — Endpoint del Backend for Frontend en AWS
VITE_BFF_URL=https://<api-gateway-id>.execute-api.<region>.amazonaws.com/api/v1

# Cognito Hosted UI — User Pool Residentes
VITE_COGNITO_DOMAIN=<prefix>-<account-id>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<cognito-app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Nombre del Condominio para la UI
VITE_CONDOMINIO_NOMBRE="Torres del Parque"
