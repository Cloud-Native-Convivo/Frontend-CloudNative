{
  "name": "frontend-cloudnative",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node check-local-env.mjs && vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "oxfmt src eslint.config.js vite.config.ts",
    "format:check": "oxfmt --check src eslint.config.js vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cuelume": "^0.2.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.11.0",
    "sileo": "^0.1.6",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "oxc-transform-react": "^0.158.0",
    "oxfmt": "^0.79.0",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
